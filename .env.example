# Runtime
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
MAX_INCIDENT_BODY_BYTES=65536
DATA_DIR=/app/data
REPORTS_DIR=/app/reports
FRONTEND_DIST_DIR=/app/frontend/dist

# Data stores
DATABASE_URL=postgresql+psycopg://incident:incident@postgres:5432/incident_copilot
REDIS_URL=redis://redis:6379/0

# Providers (mock: local HTTP; rules: no external provider; live: Anthropic with a key)
LLM_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=12
LLM_TOTAL_TIMEOUT_SECONDS=15
MOCK_LLM_URL=http://toxiproxy:8666

# Reliability controls
CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=10
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=86400

# Local dashboards
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=incident-copilot
